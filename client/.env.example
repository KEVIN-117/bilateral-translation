# URL del CMS Strapi que respalda auth y contenido
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# URL base del BFF (los Route Handlers de este mismo Next)
NEXT_PUBLIC_API_URL=/api

# URL pública del frontend
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Ruta del mismo origen que Next reescribe hacia FastAPI (Seña -> Texto)
NEXT_PUBLIC_ML_API_URL=/api/ml/api/v1
